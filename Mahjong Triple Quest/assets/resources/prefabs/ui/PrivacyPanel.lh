{
  "_$id": "privacy-root",
  "_$type": "Sprite",
  "name": "PrivacyPanel",
  "x": 0,
  "y": 0,
  "width": 750,
  "height": 1334,
  "_$child": [
    {
      "_$id": "privacy-panel",
      "_$type": "GImage",
      "name": "PanelImage",
      "x": 45,
      "y": 125,
      "width": 660,
      "height": 1080,
      "src": "res://b4cd53be-76ca-45aa-9e80-455b6c6c12cf",
      "autoSize": false
    },
    {
      "_$id": "privacy-title",
