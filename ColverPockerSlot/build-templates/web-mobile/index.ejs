<!DOCTYPE html>
<html><head>
<meta charset="utf-8">
<title>100 Blazing Clover</title>
<meta name="viewport" content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<link rel="stylesheet" href="<%= cssUrl %>">
<style>
html,body { margin:0; background:#000; }
#clover-startup { position:fixed; inset:0; z-index:99999; background:#000; color:#fff; display:flex; align-items:center; justify-content:center; flex-direction:column; font:22px Arial,sans-serif; touch-action:none; }
#clover-startup img { width:128px; height:128px; animation:clover-turn 1.5s linear infinite; }
#clover-startup p { margin:4px 0 0; }
#clover-startup button { margin-top:20px; border:1px solid #777; color:#fff; background:#000; padding:12px 28px; font:18px Arial; }
@keyframes clover-turn { to { transform:rotate(360deg); } }
</style>
</head><body>
<div id="clover-startup" role="status" aria-live="polite">
<img alt="" src="data:image/png;base64,">
<p id="clover-startup-message">Loading 0%</p>
<button id="clover-startup-retry" hidden onclick="location.reload()">RETRY</button>
</div>
<script>
(function(){
  function retry(failed) {
    var button=document.getElementById('clover-startup-retry');
    if(button)button.hidden=false;
    var message=document.getElementById('clover-startup-message');
    if(failed&&message)message.textContent='Unable to load. Check connection.';
  }
  window.addEventListener('error',function(event){if(event.target&&event.target.tagName==='SCRIPT')retry(true);},true);
  window.addEventListener('unhandledrejection',function(){retry(true);});
  // A slow engine download can be retried without pretending to know its byte progress.
  setTimeout(function(){retry(false);},30000);
})();
</script>
<div id="GameDiv" cc_exact_fit_screen="true"><div id="Cocos3dGameContainer">
<canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="99"></canvas>
</div></div>
<%- include(cocosTemplate, {}) %>
</body></html>
